# Base URL of the deployed BlastX Esports backend (includes the /v1 prefix)
VITE_API_BASE_URL=https://blastx-esports-backend-production-4b5f.up.railway.app/v1

# --- Dev-only sign-in bypass (optional) --------------------------------------
# Active ONLY during `npm run dev` AND when VITE_DEV_LOGIN=true. A production
# build (`vite build`) strips the whole feature out, so it can never ship.
# It adds a "Dev sign-in — skip OTP" button that opens the admin UI without the
# email OTP round-trip. NOTE: it's a client-side convenience only — the sentinel
# session is not accepted by the backend, so live data does not load through it.
# VITE_DEV_LOGIN=true
# VITE_DEV_ADMIN_EMAIL=dev-admin@blastix.local
# VITE_DEV_ADMIN_NAME=Dev Admin
